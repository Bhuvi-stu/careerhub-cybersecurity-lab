# CareerHub local lab credentials
# Copy this file to .env and replace the placeholder values.
# NEVER commit the .env file.

SECRET_KEY=replace-with-a-local-random-secret

CAREERHUB_ADMIN_EMAIL=admin@careerhub.local
CAREERHUB_ADMIN_PASSWORD=replace-with-your-local-admin-password

CAREERHUB_ALICE_EMAIL=alice@careerhub.local
CAREERHUB_ALICE_PASSWORD=replace-with-your-local-alice-password

CAREERHUB_BOB_EMAIL=bob@careerhub.local
CAREERHUB_BOB_PASSWORD=replace-with-your-local-bob-password
